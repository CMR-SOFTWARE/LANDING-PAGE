{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.cmrsoftwaresolutions.com" }],
      "destination": "https://cmrsoftwaresolutions.com/:path*",
      "permanent": true
    },
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/asesoramiento.html", "destination": "/asesoramiento", "permanent": true },
    { "source": "/privacidad.html", "destination": "/privacidad", "permanent": true },
    { "source": "/cookies.html", "destination": "/cookies", "permanent": true },
    { "source": "/terminos.html", "destination": "/terminos", "permanent": true },
    { "source": "/sobre-nosotros.html", "destination": "/sobre-nosotros", "permanent": true },
    { "source": "/contacto.html", "destination": "/contacto", "permanent": true },
    { "source": "/servicios/index.html", "destination": "/servicios", "permanent": true },
    { "source": "/servicios/desarrollo-software.html", "destination": "/servicios/desarrollo-software", "permanent": true },
    { "source": "/servicios/software-a-medida.html", "destination": "/servicios/software-a-medida", "permanent": true },
    { "source": "/servicios/desarrollo-web.html", "destination": "/servicios/desarrollo-web", "permanent": true },
    { "source": "/servicios/automatizacion.html", "destination": "/servicios/automatizacion", "permanent": true },
    { "source": "/proyectos/index.html", "destination": "/proyectos", "permanent": true },
    { "source": "/proyectos/ecommerce-ferreteria.html", "destination": "/proyectos/ecommerce-ferreteria", "permanent": true },
    { "source": "/proyectos/gestion-canchas.html", "destination": "/proyectos/gestion-canchas", "permanent": true },
    { "source": "/proyectos/unidad-sanitaria.html", "destination": "/proyectos/unidad-sanitaria", "permanent": true },
    { "source": "/proyectos/joby.html", "destination": "/proyectos/joby", "permanent": true },
    { "source": "/blog/index.html", "destination": "/blog", "permanent": true },
    { "source": "/blog/software-a-medida-para-pymes.html", "destination": "/blog/software-a-medida-para-pymes", "permanent": true },
    { "source": "/blog/automatizacion-de-procesos-empresariales.html", "destination": "/blog/automatizacion-de-procesos-empresariales", "permanent": true },
    { "source": "/blog/desarrollo-web-en-san-nicolas.html", "destination": "/blog/desarrollo-web-en-san-nicolas", "permanent": true }
  ],
  "rewrites": [
    { "source": "/asesoramiento", "destination": "/asesoramiento.html" },
    { "source": "/privacidad", "destination": "/privacidad.html" },
    { "source": "/cookies", "destination": "/cookies.html" },
    { "source": "/terminos", "destination": "/terminos.html" },
    { "source": "/sobre-nosotros", "destination": "/sobre-nosotros.html" },
    { "source": "/contacto", "destination": "/contacto.html" },
    { "source": "/servicios", "destination": "/servicios/index.html" },
    { "source": "/servicios/desarrollo-software", "destination": "/servicios/desarrollo-software.html" },
    { "source": "/servicios/software-a-medida", "destination": "/servicios/software-a-medida.html" },
    { "source": "/servicios/desarrollo-web", "destination": "/servicios/desarrollo-web.html" },
    { "source": "/servicios/automatizacion", "destination": "/servicios/automatizacion.html" },
    { "source": "/proyectos", "destination": "/proyectos/index.html" },
    { "source": "/proyectos/ecommerce-ferreteria", "destination": "/proyectos/ecommerce-ferreteria.html" },
    { "source": "/proyectos/gestion-canchas", "destination": "/proyectos/gestion-canchas.html" },
    { "source": "/proyectos/unidad-sanitaria", "destination": "/proyectos/unidad-sanitaria.html" },
    { "source": "/proyectos/joby", "destination": "/proyectos/joby.html" },
    { "source": "/blog", "destination": "/blog/index.html" },
    { "source": "/blog/software-a-medida-para-pymes", "destination": "/blog/software-a-medida-para-pymes.html" },
    { "source": "/blog/automatizacion-de-procesos-empresariales", "destination": "/blog/automatizacion-de-procesos-empresariales.html" },
    { "source": "/blog/desarrollo-web-en-san-nicolas", "destination": "/blog/desarrollo-web-en-san-nicolas.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)$",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/IMG/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=2592000" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" },
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" }
      ]
    },
    {
      "source": "/site.webmanifest",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    },
    {
      "source": "/llms.txt",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    }
  ]
}
